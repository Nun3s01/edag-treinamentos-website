---
import FloatingInput from './FormularioFooter/FloatingInput.astro';
import FloatingTextarea from './FormularioFooter/FloatingTextarea.astro';
import Button from './FormularioFooter/Button.astro';

const year = new Date().getFullYear();
---

<footer>
  <div class="footer-container">
    
    <div id="contato" class="contato-section">
      
      <div class="contato-info">
        <h2>Contato</h2>
        <p class="desc">Ficou com alguma dúvida ou quer saber mais sobre nossos treinamentos? Fale Conosco.</p>
        <div class="cont-content-tel-email">
          <div class="content-tel-email">
            <svg xmlns="http://www.w3.org/2000/svg" class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <p class="desc-content-tel-email">(19) 99999-9999</p>
          </div>
          <div class="content-tel-email">
            <svg xmlns="http://www.w3.org/2000/svg" class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <p class="desc-content-tel-email">atendimento@edagtreinamentos.com.br</p>
          </div>
        </div>
      </div>
      
      <div class="formulario-wrapper">
        <form class="formulario-contato">
          <FloatingInput label="Nome Completo" id="nome" type="text" maxlength="50" minlength="3" onlyLetters={true} required={true} />
          <FloatingInput label="E-mail" id="email" type="email" required={true} />
          <FloatingInput label="Telefone" id="telefone" type="tel" mask="phone" minlength="15" required={true} />
          <FloatingTextarea label="Mensagem" id="mensagem" maxlength="500" minlength="10" rows="4" required={true} />        
          
          <Button text="Enviar" type="submit" fullWidth={true} />
        </form>
      </div>
    </div>

    <hr class="divisor" />

    <div class="bottom-bar">
      <p class="copyright">
        &copy; {year} EDAG Treinamentos. Todos os direitos reservados.
      </p>
      
      <ul class="socials">
        <li>
          <a href="https://www.instagram.com/" aria-label="Instagram" target="_blank">
            <svg xmlns="http://www.w3.org/2000/svg" class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
        </li>

        <li>
          <a href="https://br.linkedin.com/" aria-label="LinkedIn" target="_blank">
            <svg xmlns="http://www.w3.org/2000/svg" class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
              <rect x="2" y="9" width="4" height="12"></rect>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
          </a>
        </li>
      </ul>
    </div>
  </div>
</footer>

<style>
  footer {
    background-color: #1a1a1a;
    color: #ffffff;
    border-top: 1px solid #333;
    margin-top: auto;
    width: 100%;
    overflow-x: hidden;
  }

  .footer-container {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 5rem 20px 2rem 20px;
    box-sizing: border-box;
  }

  /* --- SEÇÃO DE CONTATO --- */
  .contato-section {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 60px;
  }

  /* LADO ESQUERDO */
  .contato-info {
    flex: 1;
    max-width: 480px;
    padding-top: 10px;
  }

  .contato-info h2 {
    margin: 0;
    padding-bottom: 1.5rem;
    color: #ff0000;
    font-size: 2.5rem;
    line-height: 1.1;
  }

  .desc {
    color: #ccc;
    font-size: 1rem;
    line-height: 1.6;
    margin: 0;
  }

  
  .cont-content-tel-email{
    display: flex;
    flex-direction: line;
    justify-content: space-between;
    align-items: center;
    margin-top: 50px;
  }
  
  .desc-content-tel-email {
    margin: 0;
    color: #ccc;
    font-size: .8rem;
    line-height: .5rem;
}

  .content-tel-email {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    gap: 10px;
  }


  /* LADO DIREITO (FORMULÁRIO) */
  .formulario-wrapper {
    flex: 1;
    width: 100%;
    max-width: 500px;
  }

  .formulario-contato {
    display: flex;
    flex-direction: column;
    width: 100%;
    justify-content: center;
    align-items: center;
  }

  /* --- DIVISOR E BARRA INFERIOR --- */
  .divisor {
    border: 0;
    border-top: 1px solid #333;
    margin: 5rem 0 2rem 0;
    opacity: 0.5;
  }

  .bottom-bar {
    display: flex;
    justify-content: space-between; /* Copyright na esquerda, Links na direita */
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
  }

  .copyright {
    font-size: 0.9rem;
    opacity: 0.8;
    margin: 0;
  }

  .socials {
    list-style: none;
    display: flex;
    align-items: center; /* Centraliza verticalmente os ícones */
    gap: 20px; /* Espaço entre os ícones */
    margin: 0;
    padding: 0;
  }

  .socials a {
    color: white;
    text-decoration: none;
    display: flex; /* Para centralizar o SVG dentro do link */
    transition: color 0.3s ease, transform 0.3s ease;
  }

  /* Estilo dos Ícones SVG */
  .icon {
    color: #ccc;
    width: 24px;
    height: 24px;
  }

  .socials a:hover {
    color: #ff0000; /* Ícone fica vermelho ao passar o mouse */
    transform: translateY(-3px);  /* Efeito sutil de subida */
  }

  /* --- RESPONSIVIDADE --- */
  @media (max-width: 900px) {
    .contato-section {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 30px;
      scroll-margin-top: 120px;
    }

    .contato-info {
      max-width: 100%;
    }

    .formulario-wrapper {
      max-width: 100%;
    }

    .divisor {
      margin: 3rem 0 2rem 0;
    }

    .bottom-bar {
      flex-direction: column-reverse;
      text-align: center;
    }
  }



</style>