---
import BlurText from './BlurText/BlurText.tsx';
import ShinyText from './ShinyText/ShinyText.tsx';
import RotatingText from './RotatingText/RotatingText.tsx';
import AnimatedContent from './AnimatedContent/AnimatedContent.tsx';

// Definindo os textos rotativos como constantes para facilitar leitura
const rotatingTexts1 = ['seguro', 'consciente', 'organizado', 'humano', 'produtivo', 'inteligente', 'gentil', 'ágil'];
const rotatingTexts2 = ['fluido', 'eficiente', 'responsável', 'confiável', 'dinâmico', 'funcional', 'ético', 'veloz'];
---

<section class="hero-section">
  <video autoplay muted loop playsinline class="video-bg" poster="/videos/hero-poster-background.jpg">
    <source src="/videos/hero-video.mp4" type="video/mp4" />
  </video>

  <div class="overlay"></div>

  <div class="container hero-content">
    
    <h1>
      <BlurText 
        text="Excelência em Treinamentos" 
        delay={60} 
        stepDuration={0.8} 
        animateBy="words" 
        direction="bottom" 
        className="text-2xl mb-8" 
        client:visible 
      />
    </h1>
    
    <div class="slogan-text-hero">
      <p class="intro-text">Capacitando profissionais para um trânsito mais</p>
      
      <div class="rotating-group">
        <div class="text-rotating-and-e">
          <RotatingText
            texts={rotatingTexts1}
            mainClassName="px-2 sm:px-2 md:px-3 bg-cyan-300 text-black overflow-hidden py-0.5 sm:py-1 md:py-2 justify-center rounded-lg rotating-box"
            staggerFrom={"first"}
            initial={{ y: "100%", opacity: 0 }}
            animate={{ y: 0, opacity: 1}}
            exit={{ y: "-20px", opacity: 0 }}
            staggerDuration={0.025}
            splitLevelClassName="overflow-hidden pb-0.5 sm:pb-1 md:pb-1"
            transition={{ type: "spring", damping: 30, stiffness: 400 }}
            rotationInterval={6000}
            client:visible
          />
        </div>
        
        <p class="conjunction">e</p>
        
        <div class="text-rotating-and-e">
          <RotatingText
            texts={rotatingTexts2}
            mainClassName="px-2 sm:px-2 md:px-3 bg-cyan-300 text-black overflow-hidden py-0.5 sm:py-1 md:py-2 justify-center rounded-lg rotating-box"
            staggerFrom={"last"}
            initial={{ y: "100%", opacity: 0 }}
            animate={{ y: 0, opacity: 1}}
            exit={{ y: "-20px", opacity: 0 }}
            staggerDuration={0.025}
            splitLevelClassName="overflow-hidden pb-0.5 sm:pb-1 md:pb-1"
            transition={{ type: "spring", damping: 30, stiffness: 400 }}
            rotationInterval={7000}
            client:visible
          />
        </div>
      </div>
    </div>

    <AnimatedContent
      distance={30}
      direction="vertical"
      reverse={false}
      duration={3}
      ease="power3.out"
      initialOpacity={0}
      animateOpacity
      scale={1.1}
      threshold={0.2}
      delay={1.5}
      client:visible
    >
      <div class="btn-cta-container">
        <a href="#contato" class="btn-cta">
          <ShinyText text="Fale com um Especialista" disabled={false} speed={3.5} className='custom-class' client:visible />
        </a>
      </div>
    </AnimatedContent>
  </div>
</section>

<style>
  /* --- Layout Desktop (Base) --- */
  .hero-section {
    position: relative;
    /* Altura calculada para descontar a navbar fixa */
    height: calc(100vh - 90px); 
    min-height: 600px;
    display: flex;
    justify-content: center;
    align-items: center;
    color: white;
    background: #000; /* Fundo preto caso o vídeo falhe */
    overflow: hidden;
    border-bottom: 1px solid #000;
    box-shadow: 0 1px 10px #000;
    z-index: 10; /* Ajustado para não brigar com o menu (que é 1000) */
  }
  
  .video-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.65);
    z-index: 1;
  }

  .hero-content {
    /* Centralização e posicionamento */
    position: relative;
    z-index: 10;
    width: 100%;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-bottom: 3rem; /* Leve ajuste visual */
  }
  
  h1 {
    font-family: 'Poppins', sans-serif;
    font-size: 3.5rem;
    font-weight: 700;
    line-height: 1.1;
    text-shadow: 0 2px 10px rgba(0,0,0,0.5);
    margin-bottom: 1.5rem; /* Espaço entre título e slogan */
    max-width: 900px;
  }

  /* --- Slogan e Texto Rotativo --- */
  .slogan-text-hero {
    display: flex;
    flex-direction: row; /* Organiza verticalmente por padrão */
    align-items: center;
    gap: 0.5rem;
    user-select: none;
  }

  .intro-text {
    font-family: 'Poppins', sans-serif;
    font-size: 1.25rem;
    opacity: 0.9;
    text-shadow: 0 0px 15px rgba(255, 255, 255, 0.5);
    text-align: center;
    margin: 0;
  }

  /* Grupo dos rotativos (fica em linha no desktop) */
  .rotating-group {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap; /* Importante para mobile */
    gap: 8px;
  }

  .conjunction {
    font-size: 1.15rem;
    margin: 0 5px;
  }

  .text-rotating-and-e {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    border-radius: 6px;
  }

  /* --- Botão CTA --- */
  .btn-cta-container {
    margin-top: 5rem; /* Reduzido de 7rem para ficar mais próximo */
    display: flex;
    justify-content: center;
  }

  .btn-cta {
    display: inline-block;
    background-color: transparent;
    font-family: "Poppins", sans-serif;
    font-weight: 600;
    font-size: 0.9rem;
    border: 1px solid #cc0000;
    border-radius: 50px;
    cursor: pointer;
    padding: 0.4rem 2rem; /* Padding interno do link */
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    text-decoration: none; /* Remove sublinhado */
  }

  .btn-cta:hover {
    background-color: #cc0000;
    transform: translateY(-2px);
    box-shadow: 0 6px 15px rgba(204, 0, 0, 0.4);
  }

  /* =========================================
     RESPONSIVIDADE (Mobile < 768px)
     ========================================= */
  @media (max-width: 768px) {
    .hero-section {
      height: auto; /* Altura flexível */
      min-height: 100vh; /* Ocupa bem a tela */
      padding: 6rem 0 4rem 0; /* Espaço interno generoso */
    }

    .hero-content {
      margin-top: 0; /* Remove margem negativa antiga */
    }

    .container {
      padding: 0;
    }

    h1 {
      font-size: 1.4rem; /* Fonte menor */
      margin-bottom: 2rem;
    }
    .slogan-text-hero {
      flex-direction: column  ; /* Organiza verticalmente por padrão */
    }

    .intro-text {
      font-size: 0.75rem;
      max-width: 300px; /* Limita largura para quebrar linha bonito */
      margin-bottom: 0.5rem;
    }

    .rotating-group {
      flex-direction: row; /* ao lado do outro no mobile */
    }

    .conjunction {
      font-size: 0.75rem;
      margin: 2px 0;
    }

    /* Ajuste fino nos boxes rotativos */
    :global(.rotating-box) {
      font-size: 0.9rem !important;
      padding: 2px 8px !important;
    }

    .btn-cta-container {
      margin-top: 2rem;
    }
    
    .btn-cta {
        padding: 0.1rem 0.1rem;
        font-size: 0.7rem;
    }
  }
</style>