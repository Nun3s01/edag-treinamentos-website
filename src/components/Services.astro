        tooltip: ""
    },
    {
        name: "NR 17",
        cargahor: "4 Hrs",
        modalidade: "-",
        certificacao: true,
        tooltip: "Ergonomia"
    },
];

// --- 2. Ícone SVG (Sem bibliotecas externas) ---
const CheckIcon = `<svg class="icon check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>`;
const XIcon = `<svg class="icon cross" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>`;
---

<AnimatedContent
    distance={80}
    direction="vertical"
    reverse={false}
    duration={2.5}
    ease="power3.out"
    initialOpacity={0}
    animateOpacity
    scale={1}
    threshold={0.2}
    delay={0}
    client:visible
>
<section class="services-section">
    <div class="services-container">
        <div class="section-header">
            <div id="treinamentos-e-capacitacao" class="title-container">
                <h2>Treinamentos e Capacitação</h2>
                <hr>
            </div>
            <p>Nossa responsabilidade é elevar o nível da sua frota.</p>
        </div>

        <div class="two-grid-container">
            <section class="comparison-section">
                <div class="table-container">
                    <div class="table-wrapper">
                        <table class="comparison-table">
                            <thead>
                                <tr>
                                    <th id="table-headers-treinamentos" class="table-headers">Treinamentos</th>
                                    <th id="table-headers-cargahoraria" class="table-headers">Carga Horária</th>
                                    <th id="table-headers-modalidade" class="table-headers">Modalidade</th>
                                    <th id="table-headers-certificacao" class="table-headers">Certificação</th>
                                </tr>
                            </thead>
                            <tbody>
                                {features.map((item) => (
                                    <tr>
                                        <td class="feature-cell">
                                            <span class="feature-name">{item.name}</span>
                                            {item.tooltip && <span class="tooltip">{item.tooltip}</span>}
                                        </td>

                                        <td class="default-cell">
                                            <div class="cell-content">
                                                {<span class="text-value">{item.cargahor}</span>}
                                            </div>
                                        </td>

                                        <td class="default-cell">
                                            <div class="cell-content">
                                                {<span class="text-value">{item.modalidade}</span>}
                                            </div>
                                        </td>
                                        <td class="default-cell">
                                            <div class="cell-content">
                                                {typeof item.certificacao === 'boolean' 
                                                    ? (item.certificacao ? <span set:html={CheckIcon} /> : <span set:html={XIcon} />)
                                                    : <span class="text-value">{item.certificacao}</span>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                        <p>Obs.: Formatamos treinamentos com temas conforme sua necessidade!</p>
                    </div>
                </div>
            </section>
            <div class="cards-grid">
            {
                content.map((content) => (
                <div class="card">
                    <div class="icon-box">
                    {content.icon === "shield" && (
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-badge-check-icon lucide-badge-check">
                            <path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/>
                            <path d="m9 12 2 2 4-4"/>
                        </svg>
                    )}
                    {content.icon === "leaf" && (
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z" />
                            <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12" />
                        </svg>
                    )}
                    {content.icon === "traffic" && (
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" >
                            <circle cx="12" cy="12" r="10" />
                            <path d="M12 6v6l4 2" />
                        </svg>
                    )}
                    </div>
    
                    <h3>{content.title}</h3>
                    <p>{content.desc}</p>
    
                </div>
                ))
            }
            </div>
        </div>
    </div>
</section>

<section>
    <div style={{ height: '200px', position: 'relative', overflow: 'hidden', }}>
        <LogoLoop logos={imageLogos} speed={30} direction="left" logoHeight={48} gap={120} hoverSpeed={30} fadeOut fadeOutColor="#f2f2f2" ariaLabel="Partners enterprises" client:visible />
    </div>
</section>

</AnimatedContent>


<style>
    .services-section {
        padding: 0 20px 6rem 20px;
        background-color: #f2f2f2;
        color: white;
    }

    .services-container {
        max-width: 1280px;
        margin: 0 auto;
    }

    /* Cabeçalho da Seção */
    .section-header {
        text-align: center;
        margin-bottom: 4rem;
    }

    .title-container {
        padding-top: 40px;
        width: 50%;
    }

    .title-container h2 {
        color: #ff0000;
        font-size: 2.5rem;
        margin-bottom: 1rem;
        text-align: center;
    }
    
    .section-header p {
        font-size: 1.3rem;
        text-align: right;
        color: transparent;
        text-shadow: 0px 2px 3px rgba(255,255,255,0.5);
        background-color: #565656;
        -webkit-background-clip: text;
            -moz-background-clip: text;
                background-clip: text;
    }

    .two-grid-container {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        gap: 40px;
    }



    /* Grid dos Cards */
    .cards-grid {
        display: flex;
        flex-direction: column;
        gap: 30px;
        width: 25%;
        align-items: center;
        justify-content: center;
    }

    /* Estilo do Card */
    .card {
        background: #1e1e1e; /* Um pouco mais claro que o fundo */
        padding: 40px 30px;
        border-radius: 8px;
        border: 1px solid #333;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

    /* Efeito Hover do Card */
    .card:hover {
        transform: translateY(-5px);
        border-color: #000000;
        box-shadow: 5px 4px 15px rgba(0, 0, 0, 0.721);
    }

    /* Ícone */
    .icon-box {
        background: rgba(255, 0, 0, 0.1);
        color: #ff0000;
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 20px;
        display: inline-flex;
        transition: all 0.3s ease;
    }

    .card:hover .icon-box {
        background: #ff0000;
        color: white;
    }

    h3 {
        font-size: 1.5rem;
        margin-bottom: 15px;
        font-weight: 600;
    }

    p {
        color: #aaa;
        line-height: 1.6;
        margin-bottom: 25px;
        flex-grow: 1; /* Faz o texto empurrar o link para o final */
        text-align: justify;
    }

    /* Link "Saiba mais" */
    .card-link {
        color: white;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 5px;
        transition: gap 0.2s;
    }

    .card-link:hover {
        color: #ff0000;
        gap: 10px; /* A setinha se move para a direita */
    }

    /* Responsividade */
    @media (max-width: 768px) {
        .section-header h2 {
        font-size: 2rem;
        }
        .cards-grid {
        grid-template-columns: 1fr; /* Uma coluna no celular */
        }
    }



    /* --- Layout Geral --- */
    .comparison-section {
        padding: 0 0 4rem 0;
    }

    .table-container {
        max-width: 1000px;
        margin: 0 auto;
    }

    /* --- Tabela --- */
    .table-wrapper {
        width: 100%;
        position: relative; 

    }
    .comparison-table {
        width: 100%;
    }


    /* --- Cabeçalhos das Colunas --- */
    th {
    position: sticky;
    top: 103px; 
    backdrop-filter: blur(4px);
    color: #000000 !important;
    background-color: #e7e7e753 !important;
        background-clip: border-box !important;
    border: 1px solid #9a9a9a53 !important;
    border-radius: 10px;
    }

    .table-headers {
        padding: 1.6rem 20px;
        text-align: center;
        color: transparent;
        font-size: 1rem;
        border-bottom: 1px solid #ccc;
        text-shadow: 0px 2px 3px rgba(255,255,255,0.5);
        background-color: #000000;
        -webkit-background-clip: text;
                background-clip: text;
    }

    #table-headers-certificacao {
        width: 5%;
    }
    #table-headers-modalidade {
        width: 30%;
    }
    #table-headers-cargahoraria {
        width: 20%;
    }
    #table-headers-treinamentos {
        width: 60%;
    }

    /* --- Células do Corpo --- */
    td {
        padding: 1.2rem;
        border-bottom: 1px solid #cccccc5b;
        vertical-align: middle;
    }

    .feature-cell {
        text-align: left;
    }

    .feature-name {
        display: block;
        font-weight: 600;
        font-size: 1rem;
        color: #333;
    }

    .tooltip {
        display: block;
        font-size: 0.85rem;
        color: #888;
        margin-top: 4px;
        font-weight: 400;
    }

    .default-cell {
        border-right: 1px solid #eee;
        color: transparent;
        text-shadow: 0px 2px 3px rgba(255,255,255,0.5);
        background-color: #565656;
        -webkit-background-clip: text;
            -moz-background-clip: text;
                background-clip: text;
    }

    .cell-content {
        display: flex;
        justify-content: center;
        align-items: center;
        text-align: center;
    }

    /* Texto Livre na tabela */
    .text-value {
        font-size: 0.95rem;
    }

    /* --- Estilização dos Ícones --- */
    :global(.icon) {
        width: 24px;
        height: 24px;
    }
    :global(.check) {
        color: #565656; /* Tem Certificado */
    }
    :global(.cross) {
        color: #565656; /* Não tem Certificado */
    }
    </style>
