        tooltip: ""
    },
    {
        name: "Atendimento ao Cliente",
        cargahor: "4 Hrs",
        modalidade: "-",
        certificacao: true,
        tooltip: ""
    },
    {
        name: "Noções de Desenvolvimento de Liderança",
        cargahor: "4 Hrs",
        modalidade: "-",
        certificacao: true,
        tooltip: ""
    },
    {
        name: "Gestão de Tempo",
        cargahor: "4 Hrs",
        modalidade: "-",
        certificacao: true,
        tooltip: ""
    },
    {
        name: "Administração de Conflitos",
        cargahor: "4 Hrs",
        modalidade: "-",
        certificacao: true,
        tooltip: ""
    },
    {
        name: "Noções de Primeiros Socorros",
        cargahor: "4 Hrs",
        modalidade: "-",
        certificacao: true,
        tooltip: ""
    },
    {
        name: "Prevenção de Incêndio",
        cargahor: "4 Hrs",
