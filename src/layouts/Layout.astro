---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<!DOCTYPE html>
<html lang="pt-br">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/ico" href="/logos/edag-logo.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>EDAG | Treinamentos em Transportes</title>
	</head>
	<body>
		<Navbar />
		<slot />
		<Footer />
    <script>
      import Lenis from 'lenis';
      
      // 1. Inicializa o Lenis
      const lenis = new Lenis({
        duration: 1.2,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        smoothWheel: true,
      });

      // 2. Loop de animação
      function raf(time) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }

      requestAnimationFrame(raf);

      // 3. CAPTURA DE CLIQUES (Versão Robusta)
      // Ouve cliques no site inteiro
      document.addEventListener('click', (e) => {
        // Verifica se o que foi clicado está dentro de um link <a>
        // (Isso resolve casos onde você clica num ícone ou texto dentro do link)
        const link = (e.target as HTMLElement).closest('a');
        
        if (link) {
          const href = link.getAttribute('href');
          
          // Se o link existe e começa com # (ex: #contato)
          if (href && href.startsWith('#') && href.length > 1) {
            e.preventDefault(); // Impede o "pulo" seco padrão do navegador
            lenis.scrollTo(href); // Manda o Lenis deslizar suavemente
          }
        }
      });
    </script>
	</body>
</html>

<style is:global>
  @font-face {
    font-family: 'Helvetica';
    src: url('/fonts/helvetica-255/Helvetica-Bold.ttf') format('truetype');
    font-weight: bold;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Poppins';
    src: url('/fonts/Poppins/Poppins-Regular.ttf') format('truetype');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Poppins';
    src: url('/fonts/Poppins/Poppins-Bold.ttf') format('truetype');
    font-weight: bold;
    font-style: normal;
    font-display: swap;
  }

  /* CSS OBRIGATÓRIO DO LENIS */
  html.lenis, html.lenis body {
    height: auto;
  }

  .lenis.lenis-smooth {
    scroll-behavior: auto !important; /* Desativa o nativo para o Lenis assumir */
  }

  .lenis.lenis-smooth [data-lenis-prevent] {
    overscroll-behavior: contain;
  }

  .lenis.lenis-stopped {
    overflow: hidden;
  }

  .lenis.lenis-scrolling iframe {
    pointer-events: none; /* Melhora performance ao passar por cima de iframes/videos */
  }

  /* CSS GLOBAL DO SITE */
  html {
    font-family: 'Poppins', sans-serif;
    font-weight: normal;
    background-color: #f2f2f2;
	  color: #13151a;
    scroll-padding-top: 100px;
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: 'Helvetica', sans-serif;
    font-weight: bold;
  }

  body {
    margin: 0;
	  padding: 0;
    width: 100%;
    height: 100%;
  }
</style>